# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# uv
# (uv.lock is committed)

# pytest / mypy / ruff
.pytest_cache/
.mypy_cache/
.ruff_cache/

# CMIG runtime / data
*.parquet
!fixtures/**/*.parquet
.run/
.bkit/
# Ignore local Claude Code settings, but keep the shared agent skill in source control.
.claude/*
!.claude/skills/
.Rlib/
.bkit/runtime/
Rplots.pdf
temp_figures/

# Large external GEM fixtures: keep local, not in source control.
Recon3D.xml
fixtures/Recon3D.xml
fixtures/Recon3D.xml.gz
fixtures/Human-GEM*.xml
fixtures/human_models/
# data/gems/ is the tracked download destination of scripts/download_human_gems.py. The model
# bytes are gitignored (large, and BiGG's licence is non-commercial so CMIG must not redistribute
# them); the provenance manifest and README are tracked.
data/gems/*.xml
data/gems/*.xml.gz
!data/gems/GEM_SOURCES.json
!data/gems/README.md

# Evaluation run outputs and scratch: regenerate with `cmig <workflow> --out ...`.
# These hold large TIFF/parquet artifacts and are not source.
runs/
REVIEW/scratch_*/

# Editor / agent tooling state
.omc/
docs/.bkit-memory.json
docs/.pdca-status.json
docs/.pdca-snapshots/

# OS
.DS_Store

# Large external GEMs downloaded from BiGG / VMH: keep local, not in source control.
# data/gems/README.md and the download script ARE tracked.
data/gems/*.xml
data/gems/*.xml.gz
data/gems/*.mat
data/gems/*.json
